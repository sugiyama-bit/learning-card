{
  "name": "learning-card",
  "version": "1.0.0",
  "description": "今日の学びをInstagram Stories向けの1枚のカードにする静的Webアプリ",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp index.html styles.css app.js cards.js manifest.webmanifest icon.svg dist/",
    "deploy": "npm run build && wrangler deploy",
    "dev": "python3 -m http.server 4173"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sugiyama-bit/learning-card.git"
  },
  "bugs": {
    "url": "https://github.com/sugiyama-bit/learning-card/issues"
  },
  "homepage": "https://github.com/sugiyama-bit/learning-card#readme",
  "devDependencies": {
    "wrangler": "^4.131.1"
  },
  "private": true
}